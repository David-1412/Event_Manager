# ---------------------------------------------------------------------------
# Docker Compose interpolation source.
#
# Compose expands the ${...} expressions in docker-compose.yml (its `build.args`
# blocks) using ONLY: (1) variables already set in the shell, then (2) a file
# named exactly `.env` sitting next to docker-compose.yml. It never reads
# frontend/.env.local - that one is loaded by Next.js, and only when Next.js runs
# with frontend/ as its cwd (`npm run dev`).
#
# Browser-bound NEXT_PUBLIC_* values can reach a Docker build only as build args,
# so anything Compose cannot interpolate falls back to the `:-` default, which is
# the empty string, and next build then inlines that empty string into the client
# bundle. That is why a container built without this file shows "Firebase isn't
# configured" even though frontend/.env.local is fully populated.
#
# Copy to `.env` and fill in (`.env` is gitignored; this template is not):
#   Copy-Item .env.example .env
#
# Rebuild after editing - NEXT_PUBLIC_* are baked in at build time, so a rebuild
# that reuses cached layers still serves the previous values:
#   docker compose build --no-cache web ; docker compose up -d
#
# The Firebase web identifiers are also the literals in
# frontend/src/lib/auth/config.ts. They are project identifiers rather than
# secrets (a Firebase web API key is shipped to every browser by design), so
# duplicating them here adds no exposure. Do NOT put a real secret - a DB
# password, an Admin SDK credential - in a file that is committed.
# ---------------------------------------------------------------------------

# API origin as the *browser* sees it. Must be a host-reachable origin, never
# the docker network hostname `api`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google Maps. Unset, the map area renders its "unavailable" placeholder.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBizNSACdmz8FVfcVSjNB1t4u0kt5JjIGo
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Backend runtime (compose `environment:` on the api service).
#
# Firebase server-side verification. MUST match NEXT_PUBLIC_FIREBASE_PROJECT_ID
# above — the API validates the token's issuer/audience against this, so a
# mismatch means every real sign-in 401s against the draft endpoints. Unset,
# the API runs with the configured demo identity (development bypass).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=

# Mailbox polling. Enable only with complete AzureAd credentials; drafts the
# poller creates belong to Ingestion__MailboxOwner below (matched to a users
# row by address, created on first mail if the person has never signed in).
INGESTION_ENABLED=false
INGESTION_MAILBOX_OWNER_ADDRESS=
INGESTION_MAILBOX_OWNER_NAME=
AZUREAD_TENANT_ID=
AZUREAD_CLIENT_ID=
AZUREAD_CLIENT_SECRET=
AZUREAD_MAILBOX_ADDRESS=

# LLM extraction (optional). Unset, extraction falls back to the heuristic.
OPENAI_API_KEY=
