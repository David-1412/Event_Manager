<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources for the container build only; the app itself uses no
  NuGet.config. backend/Dockerfile passes this with `configfile` when it adds the
  host NuGet folder as an extra source, so that the only network origin a restore
  can reach is the local folder.

  Clearing the inherited list is the whole point of this file: `dotnet restore`
  appends its source argument to the inherited sources rather than replacing
  them, so nuget.org stays in the list and every package still tries the blocked
  registry. With the list cleared here, only the sources listed below plus the one
  passed on the command line are consulted. The BuildKit cache mount under
  /root/.nuget/packages is checked before any source, so a package already cached
  there is used without touching the network either way.

  The host folder below is a fallback, not a complete mirror; see the Dockerfile
  header for why the cache mount has to be the store that ends up complete.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
