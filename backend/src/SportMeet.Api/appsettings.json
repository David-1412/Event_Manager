{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sportmeet;Username=sportmeet;Password=sportmeet"
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDemoData": false
  },
  // The demo identity is a local-development bypass: while AsUserId is set, every
  // anonymous request is treated as that user, so POST /api/events is reachable
  // without a token. It belongs in appsettings.Development.json, never here -
  // this file ships to every environment, and the empty string is what makes
  // "no identity" the default rather than something an operator has to remember
  // to remove. The empty value also overrides the DemoUserOptions.AsUserId
  // default, so the bypass cannot reappear from code when the file is silent.
  // Unset, browse and detail still work; create/join honestly answer 401.
  "Demo": {
    "AsUserId": "",
    "ParticipantName": "Sam Rivera",
    "SeedHostUserId": "00000000-0000-0000-0000-000000000001",
    "SeedHostName": "Demo Host"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Firebase": {
    "ProjectId": "",
    "IssuerPrefix": "https://securetoken.google.com"
  },

  "Import": {
    "MaxPerDay": 2000,
    "MaxPerUserPerHour": 30
  },
  "Google": {
    "GeocodingApiKey": ""
  },

  "Ingestion": {
    "Enabled": false,
    "PollIntervalSeconds": 300,
    "FetchBatchSize": 25,
    "LookbackDays": 7,
    "MaxBodyChars": 12000,
    "DefaultTimezone": "Australia/Melbourne",
    "RetentionDays": 90,
    "AllowedSenders": [],
    "Mailboxes": [ { "Name": "graph" } ],
    "MailboxOwner": { "Address": "", "Name": "" }
  },
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "MailboxAddress": "",
    "FetchBatchSize": 50,
    "Folder": "Inbox"
  },
  "OpenAi": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "MaxTokensPerCall": 700,
    "Temperature": 0,
    "TimeoutSeconds": 30,
    "PromptVersion": "llm-1"
  },
  "Claude": {
    "BaseUrl": "https://api.anthropic.com/v1",
    "ApiKey": "",
    "Model": "claude-sonnet-5-5",
    "MaxTokensPerCall": 1500,
    "Temperature": 0,
    "TimeoutSeconds": 30,
    "PromptVersion": "claude-1",
    "AnthropicVersion": "2023-06-01",
    "WorkspaceId": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
