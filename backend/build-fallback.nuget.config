<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback source set for the container build: the offline folder plus nuget.org.

  backend/Dockerfile restores from the offline folder alone with build.nuget.config
  first, because a folder that covers the locked graph means no network at all. When
  it does not (a host cache resolved against different SDKs, or a fresh machine), the
  Dockerfile copies this file to backend/src/SportMeet.Api/nuget.config and restores
  with it, so nuget.org fills only the gap the folder left.

  Both origins have to be listed here. A source passed on the command line replaces
  the configfile's list rather than adding to it, so naming only the registry would
  drop the offline folder and re-download packages it already had.

  This file must sit in the same directory as the project being restored: NuGet
  resolves a relative source against the project directory, not the config file's,
  which is why the Dockerfile copies it next to SportMeet.Api.csproj instead of
  passing it from backend/.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="/offline" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
